# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env on production server
# Update values according to your production setup
# ============================================

APP_NAME="PLN Inventaris"
APP_ENV=production
APP_KEY=base64:YOUR_PRODUCTION_KEY_HERE
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# ⚠️ CRITICAL: Must use HTTPS for production
APP_URL=https://poshan.my.id/pln
ASSET_URL=https://poshan.my.id/pln

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# ============================================
# DATABASE - Update with production credentials
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pln_inventaris_production
DB_USERNAME=your_db_user
DB_PASSWORD=your_secure_password

# ============================================
# SESSION & CACHE
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/pln
SESSION_DOMAIN=poshan.my.id
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=pln_

# ============================================
# REDIS (Optional - for better performance)
# ============================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# MAIL CONFIGURATION
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@poshan.my.id"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# AWS (if using S3 for file storage)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# VITE
# ============================================
VITE_APP_NAME="${APP_NAME}"

# ============================================
# OCTANE / FRANKENPHP
# ============================================
OCTANE_SERVER=frankenphp

# ============================================
# NOTES FOR DEPLOYMENT
# ============================================
# 1. Generate new APP_KEY: php artisan key:generate
# 2. Run migrations: php artisan migrate --force
# 3. Run post-deploy script: bash scripts/post-deploy.sh
#    (This handles storage:link, permissions, asset build, and caching)
# 4. Verify: curl -I https://poshan.my.id/pln/storage/qrcodes/ should return 200
#
# IMPORTANT - Subpath /pln:
# - APP_URL and ASSET_URL must include /pln
# - SESSION_PATH must be /pln
# - Reverse proxy must forward /pln/storage/* to public/storage/
# - If using Apache: Alias /pln /path/to/public
# - If using Caddy/FrankenPHP: handle_path /pln/* { root * /var/www/html/public }
